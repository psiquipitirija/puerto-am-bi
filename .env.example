# OPCIONAL: el asistente funciona sin estas variables con su motor local.
# Si defines la clave, un modelo externo SOLO interpreta/reescribe la pregunta;
# nunca recibe los datos del Excel y nunca entrega cifras. Los números siempre
# los calcula el motor local. Nunca subas tu clave real al repositorio.

# OpenAI:
# PUERTOAM_LLM_API_KEY=tu-clave-aqui
# PUERTOAM_LLM_MODEL=gpt-4o-mini

# OpenRouter (la llave empieza con sk-or-; el modelo y el endpoint se detectan solos):
# PUERTOAM_LLM_API_KEY=sk-or-tu-clave-aqui
# PUERTOAM_LLM_MODEL=openai/gpt-4o-mini
# PUERTOAM_LLM_BASE_URL=https://openrouter.ai/api/v1/chat/completions

# Ejemplo en PowerShell antes de iniciar el servidor:
#   $env:PUERTOAM_LLM_API_KEY = "tu-clave"
#   python -m uvicorn app.main:app --host 127.0.0.1 --port 8124
